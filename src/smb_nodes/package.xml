<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smb_nodes</name>
  <version>0.1.0</version>
  <description>Higher-level ROS2 nodes for SuperMarketBot (waypoint nav, state machine).</description>
  <maintainer email="khoatnnse183385@fpt.edu.vn">Khoa Tran</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>smb_msgs</exec_depend>
  <!-- nav2_simple_commander provides BasicNavigator — used by waypoint_follower. -->
  <exec_depend>nav2_simple_commander</exec_depend>
  <!-- nav2_bringup brings up the navigation stack; waypoint_follower talks to it. -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>