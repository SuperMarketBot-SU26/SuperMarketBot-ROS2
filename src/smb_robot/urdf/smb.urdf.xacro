<?xml version="1.0" ?>
<!--
  smb.urdf.xacro — SuperMarketBot robot description.

  Dimensions stay in sync with ESP32 Config.h (4WD differential drive).
  Used by real-robot bringup smb_robot.launch.py.

  Physical model:
    chassis (base_link): 0.27 x 0.145 x 0.075 m
    wheel radius:        0.0325 m (65mm diameter)
    wheel thickness:     0.026 m
    track:               0.150 m (wheel-to-wheel distance)
    wheelbase:           0.140 m (front-to-rear axle distance)
    lidar offset on z:   +0.36 m (relative to base_link origin)
    imu offset on z:     +0.05 m (relative to base_link origin)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smb">

  <xacro:property name="chassis_length"  value="0.27"/>
  <xacro:property name="chassis_width"   value="0.145"/>
  <xacro:property name="chassis_height"  value="0.075"/>
  <xacro:property name="wheel_radius"    value="0.0325"/>
  <xacro:property name="wheel_thickness" value="0.026"/>
  <xacro:property name="track"           value="0.150"/>
  <xacro:property name="wheelbase"       value="0.140"/>
  <xacro:property name="wheel_offset_x"  value="${wheelbase/2}"/>

  <xacro:property name="lidar_offset_z" value="0.36"/>
  <xacro:property name="imu_offset_z"   value="0.05"/>

  <!-- Masses: chassis dominates the dynamics. -->
  <xacro:property name="chassis_mass"   value="2.0"/>
  <xacro:property name="wheel_mass"     value="0.06"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="0.0109" ixy="0" ixz="0"
        iyy="0.0178" iyz="0"
        izz="0.0231"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.5 0.5 1.0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Macro for 4WD continuous wheels -->
  <xacro:macro name="diff_wheel" params="name offset_x offset_y">
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${offset_x} ${offset_y} -${wheel_radius}" rpy="-1.5707 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="0.0000192" ixy="0" ixz="0"
          iyy="0.0000192" iyz="0"
          izz="0.0000317"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
        <material name="wheel_dark">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- 4 continuous wheels for 4WD differential drive -->
  <xacro:diff_wheel name="front_left_wheel"  offset_x="${wheel_offset_x}"  offset_y="${track/2}"/>
  <xacro:diff_wheel name="rear_left_wheel"   offset_x="-${wheel_offset_x}" offset_y="${track/2}"/>
  <xacro:diff_wheel name="front_right_wheel" offset_x="${wheel_offset_x}"  offset_y="-${track/2}"/>
  <xacro:diff_wheel name="rear_right_wheel"  offset_x="-${wheel_offset_x}" offset_y="-${track/2}"/>

  <!-- Laser frame: center-mounted on chassis (x = 0.0) and connected directly to Pi 5 USB (not through ESP32).
       The physical sensor connector/zero ray is mounted 90° clockwise from
       base_link +X, so this fixed joint applies the only required yaw offset.
       Driver-level reversion/inversion must remain disabled.
       Driver publishes scan with frame_id="laser_frame"; robot_state_publisher
       provides the TF map → odom → base_link → laser_frame. -->
  <xacro:property name="lidar_offset_x" value="0.0"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_offset_x} 0 ${lidar_offset_z}" rpy="0 0 1.5708"/>
  </joint>
  <link name="laser_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- IMU frame: inside chassis, +z by imu_offset_z. -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${imu_offset_z}" rpy="0 0 0"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0 0.5 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
    </collision>
  </link>

  <!-- Ultrasonic Sensors -->
  <!-- Front -->
  <joint name="us_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_front_link"/>
    <origin xyz="0.135 0 0" rpy="0 0 0"/>
  </joint>
  <link name="us_front_link"/>

  <!-- Rear -->
  <joint name="us_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_rear_link"/>
    <origin xyz="-0.135 0 0" rpy="0 0 3.14159"/>
  </joint>
  <link name="us_rear_link"/>

  <!-- Left -->
  <joint name="us_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_left_link"/>
    <origin xyz="0 0.0725 0" rpy="0 0 1.5708"/>
  </joint>
  <link name="us_left_link"/>

  <!-- Right -->
  <joint name="us_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_right_link"/>
    <origin xyz="0 -0.0725 0" rpy="0 0 -1.5708"/>
  </joint>
  <link name="us_right_link"/>

  <!-- AI Camera IMX500 -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Positioned at the front of the robot, facing forward (URDF +X) -->
    <origin xyz="0.135 0 0.15" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.02"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.02"/>
      </geometry>
    </collision>
  </link>

</robot>
