<?xml version="1.0" ?>
<!--
  smb.urdf.xacro — SuperMarketBot robot description.

  Dimensions must stay in sync with src/smb_robot_bringup/worlds/smb_world.sdf.
  Used by both smb_sim.launch.py (sim) and smb_robot.launch.py (real robot).

  Physical model:
    chassis (base_link): 0.30 x 0.22 x 0.13 m
    wheel radius:        0.04 m
    wheelbase (track):   0.22 m
    lidar offset on z:   +0.075 m (relative to base_link origin)
    imu  offset on z:    +0.05  m (relative to base_link origin)

  Joint dynamics are flat (no continuous motors) because the sim DiffDrive plugin
  is what actually spins the wheels. Real-robot bringup uses this URDF only as a
  source for robot_state_publisher (static TFs from base_link to sensor links).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smb">

  <xacro:property name="chassis_length" value="0.27"/>
  <xacro:property name="chassis_width"  value="0.145"/>
  <xacro:property name="chassis_height" value="0.075"/>
  <xacro:property name="wheel_radius"   value="0.04"/>
  <xacro:property name="wheel_thickness" value="0.02"/>
  <xacro:property name="track"          value="0.22"/>
  <!-- Drive wheels at the FRONT of the chassis (x = +0.05) — driven by motors with
       encoders. Single ball caster at the BACK (x = -0.05) for free-rolling turns.

       Convention: URDF +X = physical forward = arrow/ESP32 side = motor direction.
       ESP32 odom +X = motor direction = URDF +X. No odom flip needed.
       Scan data: lidar on back (-X) with 180° rotation so angle 0° faces backward
       (toward wall = physical front). -->

  <xacro:property name="wheel_offset_x" value="-0.05"/>
  <xacro:property name="caster_offset_x" value="0.05"/>
  <!-- Caster uses the same radius as the drive wheels so all three contact
       points lie on the same ground plane. The wheel_radius property above
       is reused for the caster sphere. -->

  <xacro:property name="lidar_offset_z" value="0.36"/>
  <xacro:property name="imu_offset_z"   value="0.05"/>

  <!-- Masses kept low so the sim runs smoothly; chassis dominates the dynamics. -->
  <xacro:property name="chassis_mass"   value="2.0"/>
  <xacro:property name="wheel_mass"     value="0.1"/>
  <xacro:property name="caster_mass"    value="0.05"/>

  <link name="base_link">
    <!-- KDL doesn't support a root link with inertia, but RobotDescription does.
         We ignore the inertia at the root for kinematic purposes (TF tree
         publishes static transforms only — joints are continuous/revolute/fixed
         with no dynamics). The dummy chassis makes KDL happy. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <mass value="${chassis_mass}"/>
      <!-- Box inertia for 0.30 x 0.22 x 0.13 m @ 2.0 kg:
           Ixx = m/12 * (y^2 + z^2) = 2/12 * (0.0484 + 0.0169) = 0.0109
           Iyy = m/12 * (x^2 + z^2) = 2/12 * (0.09 + 0.0169) = 0.0178
           Izz = m/12 * (x^2 + y^2) = 2/12 * (0.09 + 0.0484) = 0.0231 -->
      <inertia
        ixx="0.0109" ixy="0" ixz="0"
        iyy="0.0178" iyz="0"
        izz="0.0231"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.5 0.5 1.0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Left rear drive wheel: positive y side, REAR of chassis -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${wheel_offset_x} ${track/2} -${wheel_radius}" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <mass value="${wheel_mass}"/>
      <!-- Solid cylinder r=0.04, h=0.02, m=0.1:
           Ixx = Iyy = m/12 * (3r^2 + h^2) = 0.1/12 * (0.0048 + 0.0004) = 0.0000433
           Izz = m r^2 / 2 = 0.1 * 0.0016 / 2 = 0.00008 -->
      <inertia
        ixx="0.0000433" ixy="0" ixz="0"
        iyy="0.0000433" iyz="0"
        izz="0.00008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
  </link>

  <!-- Right rear drive wheel: negative y side, REAR of chassis -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${wheel_offset_x} -${track/2} -${wheel_radius}" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="0.0000433" ixy="0" ixz="0"
        iyy="0.0000433" iyz="0"
        izz="0.00008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
  </link>

  <!-- One passive front ball caster (free-rolling). Same offset z as the drive wheels
       (-wheel_radius) so the caster sphere bottom rests on the ground at the
       same plane as the wheel bottoms.
       URDF uses 'fixed' (KDL/RViz limitation; ball is SDF-only).
       SDF uses 'ball' for Gazebo free-rolling physics. -->
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <origin xyz="${caster_offset_x} 0 -${wheel_radius}" rpy="0 0 -1.5708"/>
  </joint>
  <link name="caster_front">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <mass value="${caster_mass}"/>
      <!-- Solid sphere r=0.04, m=0.05: I = 2/5 m r^2 = 0.4 * 0.05 * 0.0016 = 0.000032 -->
      <inertia
        ixx="0.000032" ixy="0" ixz="0"
        iyy="0.000032" iyz="0"
        izz="0.000032"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <sphere radius="${wheel_radius}"/>
      </geometry>
      <material name="caster_dark">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <sphere radius="${wheel_radius}"/>
      </geometry>
    </collision>
  </link>

  <!-- Laser frame: center-mounted on chassis (x = 0.0) and connected directly to Pi 5 USB (not through ESP32).
       LiDAR angle_min=0° points along URDF +X = physical forward.
       No extra rotation: YDLidar X3 angle 0° is already in the forward direction.
       Driver publishes scan with frame_id="laser_frame"; robot_state_publisher
       provides the TF map → odom → base_link → laser_frame. -->
  <xacro:property name="lidar_offset_x" value="0.0"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_offset_x} 0 ${lidar_offset_z}" rpy="0 0 -1.5708"/>
  </joint>
  <link name="laser_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- IMU frame: inside chassis, +z by imu_offset_z. -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${imu_offset_z}" rpy="0 0 -1.5708"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0 0.5 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
    </collision>
  </link>

  <!-- Ultrasonic Sensors -->
  <!-- Front -->
  <joint name="us_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_front_link"/>
    <origin xyz="0.135 0 0" rpy="0 0 -1.5708"/>
  </joint>
  <link name="us_front_link"/>

  <!-- Rear -->
  <joint name="us_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_rear_link"/>
    <origin xyz="-0.135 0 0" rpy="0 0 3.14159"/>
  </joint>
  <link name="us_rear_link"/>

  <!-- Left -->
  <joint name="us_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_left_link"/>
    <origin xyz="0 0.0725 0" rpy="0 0 1.5708"/>
  </joint>
  <link name="us_left_link"/>

  <!-- Right -->
  <joint name="us_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="us_right_link"/>
    <origin xyz="0 -0.0725 0" rpy="0 0 -1.5708"/>
  </joint>
  <link name="us_right_link"/>

  <!-- AI Camera IMX500 -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Positioned at the front of the robot, facing forward (URDF +X) -->
    <!-- Note: Actual offsets (xyz) depend on physical mounting, 
         using placeholder values (x: front edge, z: above chassis) -->
    <origin xyz="0.135 0 0.15" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.02"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.04 0.02"/>
      </geometry>
    </collision>
  </link>

</robot>
