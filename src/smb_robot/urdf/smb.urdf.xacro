<?xml version="1.0" ?>
<!--
  smb.urdf.xacro — SuperMarketBot robot description.

  Dimensions must stay in sync with src/smb_robot_bringup/worlds/smb_world.sdf.
  Used by both smb_sim.launch.py (sim) and smb_robot.launch.py (real robot).

  Physical model:
    chassis (base_link): 0.30 x 0.22 x 0.13 m
    wheel radius:        0.04 m
    wheelbase (track):   0.22 m
    lidar offset on z:   +0.075 m (relative to base_link origin)
    imu  offset on z:    +0.05  m (relative to base_link origin)

  Joint dynamics are flat (no continuous motors) because the sim DiffDrive plugin
  is what actually spins the wheels. Real-robot bringup uses this URDF only as a
  source for robot_state_publisher (static TFs from base_link to sensor links).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smb">

  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width"  value="0.22"/>
  <xacro:property name="chassis_height" value="0.13"/>
  <xacro:property name="wheel_radius"   value="0.04"/>
  <xacro:property name="wheel_thickness" value="0.02"/>
  <xacro:property name="track"          value="0.22"/>
  <xacro:property name="caster_offset_x" value="-0.13"/>
  <xacro:property name="caster_radius"  value="0.02"/>

  <xacro:property name="lidar_offset_z" value="0.075"/>
  <xacro:property name="imu_offset_z"   value="0.05"/>

  <xacro:property name="chassis_mass"   value="1.14395"/>
  <xacro:property name="wheel_mass"     value="2.0"/>
  <xacro:property name="caster_mass"    value="1.0"/>

  <link name="base_link">
    <!-- KDL doesn't support a root link with inertia, but RobotDescription does.
         We ignore the inertia at the root for kinematic purposes (TF tree
         publishes static transforms only — joints are continuous/revolute/fixed
         with no dynamics). The dummy chassis makes KDL happy. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="0.126164" ixy="0" ixz="0"
        iyy="0.416519" iyz="0"
        izz="0.481014"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.5 0.5 1.0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Left wheel: positive y side -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 ${track/2} -${wheel_radius}" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="0.145833" ixy="0" ixz="0"
        iyy="0.145833" iyz="0"
        izz="0.125"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
  </link>

  <!-- Right wheel: negative y side -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -${track/2} -${wheel_radius}" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>
  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="0.145833" ixy="0" ixz="0"
        iyy="0.145833" iyz="0"
        izz="0.125"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
  </link>

  <!-- Caster ball (rear, passive) -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${caster_offset_x} 0 -${wheel_radius}" rpy="0 0 0"/>
  </joint>
  <link name="caster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="0.1" ixy="0" ixz="0"
        iyy="0.1" iyz="0"
        izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_dark">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
  </link>

  <!-- Laser frame: top of chassis, +z by lidar_offset_z. Yaw = 0 (forward-facing). -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 ${lidar_offset_z}" rpy="0 0 0"/>
  </joint>
  <link name="laser_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- IMU frame: inside chassis, +z by imu_offset_z. -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${imu_offset_z}" rpy="0 0 0"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0 0.5 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
    </collision>
  </link>

</robot>
