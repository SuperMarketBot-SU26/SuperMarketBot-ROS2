<?xml version="1.0" ?>
<!--
  smb_world.sdf — Sim world for SuperMarketBot
  Adapted from ../visualize_lidar.sdf with frame name alignment to docs/TOPIC_CONTRACT.md.

  Frame hierarchy (must match docs/TOPIC_CONTRACT.md):
    map -> odom -> base_link -> laser_frame
                          -> imu_link
                          -> (wheels, caster)

  Topic publishing from sim (see ros_gz_bridge.yaml for remapping):
    /lidar              -> /scan         (sensor_msgs/LaserScan, frame_id=laser_frame)
    /imu                -> /imu/data     (sensor_msgs/Imu, frame_id=imu_link)
    /model/smb/cmd_vel  -> /cmd_vel      (geometry_msgs/Twist)
    /model/smb/odometry -> /odom         (nav_msgs/Odometry, frame=odom, child=base_link)
    /model/smb/tf       -> /tf           (tf2_msgs/TFMessage)
-->
<sdf version="1.10">
  <world name="smb_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <!-- IMU system plugin. REQUIRED for any <sensor type="imu"> to publish
         data on its gz topic (without this, the IMU sensor is created but
         never ticked, so /imu has no publishers even though the bridge is
         wired). Same pattern as Gazebo's sensors example world. -->
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <gui fullscreen="0">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
      </plugin>

      <!-- Scene tools -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <!-- World control + stats (anchored bottom-left) -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- Live LIDAR visualization directly inside the sim GUI -->
      <plugin filename="VisualizeLidar" name="Visualize Lidar">
      </plugin>

      <!-- Inspector + entity tree (docked side panels) -->
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane.
         Top surface = world z = 0. Default SDF pose would center this 0.1m-thick
         box at z=0 (top at z=+0.05), which means the robot's wheels (spawned
         with bottom at z=0.0) start 5cm below the visible ground. The physics
         solver then has to push the robot up to settle on top of the plane,
         which over the first ~5-10s of wall-clock time looks like "the car is
         sunk into the ground". Shifting the plane center to z=-0.05 puts the
         top surface at z=0, where the rest of the model assumes it is. -->
    <model name="ground_plane">
      <pose>0 0 -0.05 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle: red box (matches original visualize_lidar.sdf) -->
    <model name="box">
      <pose>0 -1 0.5 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz>
            <izz>1</izz>
          </inertia>
          <mass>1.0</mass>
        </inertial>
        <collision name="box_collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>1 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Supermarket-aisle walls to give SLAM something interesting to map.
         Static, no visual rendering needed beyond plain boxes. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.2 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.2 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Two shelf rows inside, forming an aisle -->
    <model name="shelf_row_left">
      <static>true</static>
      <pose>-1.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 6.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 6.0 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
            <specular>0.4 0.3 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_row_right">
      <static>true</static>
      <pose>1.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 6.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 6.0 1.0</size></box></geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
            <specular>0.4 0.3 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- SuperMarketBot robot (renamed from vehicle_blue for clarity).
         Scaled-down version of visualize_lidar.sdf's vehicle_blue:
           - 2 drive wheels FORWARD of chassis center (x = +0.05), large enough
             to support the front load.
           - 1 passive caster at the rear (x = -0.105), small (radius 0.02).
           - Chassis dimensions and inertia are physically correct for the
             actual 0.30 x 0.22 x 0.13 m / 2.0 kg body, so the dynamics
             match the URDF (src/smb_robot/urdf/smb.urdf.xacro). -->
    <model name='smb'>
      <!-- Model origin = chassis center. Chassis bottom is at z=-0.065 (1.5cm
           clearance above ground). Wheels (r=0.04) and caster (r=0.02) extend
           below the chassis to touch the ground at z=0. This way the chassis
           is supported by the wheels, not the other way around (the wheels
           carry the load and the chassis floats just above the ground). -->
      <pose>0 0 0.08 0 0 0.0</pose>

      <!-- base_link: main chassis. Same dimensions as URDF base_link. -->
      <link name='base_link'>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.0109</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0178</iyy><iyz>0</iyz>
            <izz>0.0231</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.3 0.22 0.13</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 1.0 1</ambient>
            <diffuse>0.5 0.5 1.0 1</diffuse>
            <specular>0.0 0.0 1.0 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.3 0.22 0.13</size>
            </box>
          </geometry>
        </collision>

        <!-- 2D lidar on top of chassis (frame_id = laser_frame).
             On Wayland+XWayland (Ubuntu 22 default) the gz GUI client hangs
             at scene-load when GPU ray tracing is enabled. Use CPU lidar
             with fewer samples so the GUI can finish loading within ~5s.
             360 samples at 10Hz is enough for SLAM and keeps CPU usage low. -->
        <sensor name='laser' type='gpu_lidar'>
          <always_on>true</always_on>
          <pose>0 0 0.075 0 0 0</pose>
          <topic>/lidar</topic>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.08</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <visualize>true</visualize>
        </sensor>

        <!-- IMU at chassis center (frame_id = imu_link).
             The <imu> block with explicit <angular_velocity>/<linear_acceleration>
             children is required in Gazebo Ionic (gz sim 10): without at least one
             noise block the sensor's data pipeline never starts, so /imu stays
             silent even though the bridge is wired. Values are MPU6050-class:
             gyro noise ~1e-4 rad/s, accel noise ~1.7e-3 m/s^2. -->
        <sensor name='imu' type='imu'>
          <always_on>true</always_on>
          <pose>0 0 0.05 0 0 0</pose>
          <topic>/imu</topic>
          <update_rate>100</update_rate>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <!-- Drive wheels (left/right) at the REAR of the chassis (x = -0.05).
           Sphere shape avoids the wheel-axis direction error that cylinder wheels
           have under the rpy=-1.5707 pose rotation.
           Matches the real robot: rear drive wheels driven by motors with encoders. -->
      <link name='left_wheel'>
        <pose>-0.05 0.11 -0.04 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000433</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000433</iyy><iyz>0</iyz>
            <izz>0.00008</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <geometry>
            <sphere>
              <radius>0.04</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere>
              <radius>0.04</radius>
            </sphere>
          </geometry>
        </collision>
      </link>

      <link name='right_wheel'>
        <pose>-0.05 -0.11 -0.04 -1.5707 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000433</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000433</iyy><iyz>0</iyz>
            <izz>0.00008</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <geometry>
            <sphere>
              <radius>0.04</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere>
              <radius>0.04</radius>
            </sphere>
          </geometry>
        </collision>
      </link>

      <!-- One passive front ball caster (free-rolling). Sphere radius 0.04 at x=+0.05.
           Ball joint so the caster rolls freely during turns — this is critical
           for DiffDrive odometry accuracy: the plugin assumes free-rolling wheels,
           and any caster dragging causes odometry errors that break SLAM scan matching. -->
      <link name='caster_front'>
        <pose>0.05 0 -0.04 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000043</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000043</iyy><iyz>0</iyz>
            <izz>0.000043</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <geometry>
            <sphere>
              <radius>0.04</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <sphere>
              <radius>0.04</radius>
            </sphere>
          </geometry>
        </collision>
      </link>

      <joint name='left_wheel_joint' type='revolute'>
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name='right_wheel_joint' type='revolute'>
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name='caster_front_joint' type='ball'>
        <parent>base_link</parent>
        <child>caster_front</child>
      </joint>

      <!-- DiffDrive: publishes odom + tf + accepts cmd_vel.
           frame_id=odom, child_frame_id=base_link, matches docs/TOPIC_CONTRACT.md. -->
      <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.22</wheel_separation>
        <wheel_radius>0.04</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>/model/smb/cmd_vel</topic>
        <odom_topic>/model/smb/odometry</odom_topic>
        <tf_topic>/model/smb/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <!-- velocity/acceleration limits: REQUIRED. Without these, the
             plugin's internal velocity target is uninitialized and it
             won't drive the wheels even when cmd_vel arrives. -->
        <max_linear_acceleration>2.5</max_linear_acceleration>
        <min_linear_acceleration>-2.5</min_linear_acceleration>
        <max_angular_acceleration>3.2</max_angular_acceleration>
        <min_angular_acceleration>-3.2</min_angular_acceleration>
        <max_linear_velocity>0.26</max_linear_velocity>
        <min_linear_velocity>-0.26</min_linear_velocity>
        <max_angular_velocity>1.0</max_angular_velocity>
        <min_angular_velocity>-1.0</min_angular_velocity>
      </plugin>

      <!-- JointStatePublisher MUST live inside a <model> entity (it walks the
           joint tree of that model). Attached here to smb so the wheels and
           caster publish their angles to /world/smb_world/model/smb/joint_state
           (gz.msgs.Model). ros_gz_bridge then forwards that to ROS2
           /joint_states so robot_state_publisher can animate the wheels in
           RViz RobotModel. Without this, Gazebo would move the wheels
           physically but RViz would still show them stuck at zero. -->
      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
      </plugin>
    </model>

  </world>
</sdf>
