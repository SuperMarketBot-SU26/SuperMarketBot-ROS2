repositories:
  # ---- SMB ROS2 packages (this repo) ----
  smb_msgs:
    type: git
    url: https://github.com/SuperMarketBot-SU26/SuperMarketBot-ROS2.git
    version: main
  smb_bridge:
    type: git
    url: https://github.com/SuperMarketBot-SU26/SuperMarketBot-ROS2.git
    version: main
  smb_robot:
    type: git
    url: https://github.com/SuperMarketBot-SU26/SuperMarketBot-ROS2.git
    version: main
  smb_robot_bringup:
    type: git
    url: https://github.com/SuperMarketBot-SU26/SuperMarketBot-ROS2.git
    version: main
  smb_nodes:
    type: git
    url: https://github.com/SuperMarketBot-SU26/SuperMarketBot-ROS2.git
    version: main

  # ---- Vendored third-party (apt does not ship these for lyrical) ----
  slam_toolbox:
    type: git
    url: https://github.com/SteveMacenski/slam_toolbox.git
    # Branch 'ros2-devel' does NOT exist upstream; the rolling-aligned
    # branch is named 'ros2'. Use 'lyrical' if you want distro-specific
    # tagging; 'ros2' tracks the latest ROS2 development.
    version: ros2
  # micro-ROS agent — source build ONLY (snap is broken on ROS 2 lyrical).
  #   The snap build uses Humble-era FastDDS (CDR v1) which is incompatible
  #   with ROS 2 lyrical FastDDS (CDR v2). Symptoms: std::bad_alloc storm,
  #   CDR deserialization mismatches, no data delivered to subscribers.
  #
  #   Build:
  #     vcs import src < ros2_ws.repos        # clones src/micro_ros_agent
  #     cd src/micro_ros_agent
  #     patch -p1 < ../../vendor-patches/micro_ros_agent/SuperBuild.cmake.patch
  #     cd /home/nhatkhoa1124/ros2_ws
  #     source /opt/ros/lyrical/setup.bash
  #     colcon build --packages-select micro_ros_agent \
  #       --cmake-args -DMICROROSAGENT_SUPERBUILD=ON -DCMAKE_BUILD_TYPE=Release
  #
  #   Binary: install/micro_ros_agent/lib/micro_ros_agent/micro_ros_agent
  #
  #   The SuperBuild.cmake patch (see vendor-patches/micro_ros_agent/) pins
  #   spdlog v1.10.0 (last release with fmt::basic_runtime) and pushes the
  #   private spdlog to the front of CMAKE_PREFIX_PATH so it wins over the
  #   system spdlog 1.15 (fmt 10+, missing basic_runtime). See
  #   micro-ROS/micro-ROS-Agent#255 and eProsima/Micro-XRCE-DDS-Agent#344
  #   for the upstream issues this works around.
  micro_ros_agent:
    type: git
    url: https://github.com/micro-ROS/micro-ROS-Agent.git
    version: rolling
  # Nav2 stack — also not on lyrical apt. Vendored as a single monorepo
  # under src/nav2_repo; colcon picks up individual packages (nav2_bringup,
  # nav2_planner, nav2_controller, nav2_bt_navigator, nav2_waypoint_follower,
  # nav2_simple_commander, etc.) from subdirs. Branch 'main' is the
  # rolling-development line; no 'rolling' or 'lyrical' branch exists
  # upstream for navigation2.
  nav2_repo:
    type: git
    url: https://github.com/ros-planning/navigation2.git
    version: main